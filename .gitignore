# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# dados do usuário (perfis e carrosséis) — cada pessoa que clonar começa do zero,
# nunca commitar dado real de ninguém aqui. IMPORTANTE: data/templates.json fica DE FORA
# desse ignore de propósito — são os modelos prontos que fazem parte do produto.
/data/profiles.json
/data/carousels.json
/data/settings.json
/data/chat-conversations.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
